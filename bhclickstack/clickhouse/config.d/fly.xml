<clickhouse>
    <!-- One Fly volume at /data. MongoDB already writes /data/db; move
         ClickHouse beside it so both databases survive deploys and restarts.
         The image default (/var/lib/clickhouse) is ephemeral overlay — this
         override IS the fix for the all-in-one persistence caveat.
         tmp/ and access/ are kept INSIDE the data path: the stock ClickHouse
         entrypoint chowns the configured path recursively, so they inherit
         correct ownership when it drops privileges. -->
    <path>/data/clickhouse/</path>
    <tmp_path>/data/clickhouse/tmp/</tmp_path>
    <access_control_path>/data/clickhouse/access/</access_control_path>

    <!-- 8GB machine shared with MongoDB, two Node processes, the collector and
         vector. Cap the server absolutely (default is ~90% of visible RAM) so
         the kernel OOM killer is never the thing that resolves memory
         pressure — an OOM kill would take ingestion down with it.
         Per-query limits live in users.d/query-limits.xml. -->
    <max_server_memory_usage>4294967296</max_server_memory_usage>
    <!-- Default mark cache is 5GB, far too large for this box. -->
    <mark_cache_size>536870912</mark_cache_size>
</clickhouse>
