{
  "uid": "beehive-telemetry-volume",
  "title": "Telemetry Volume per App",
  "tags": [
    "beehive",
    "telemetry",
    "volume"
  ],
  "description": "How much telemetry each app produces and how fast the bhgrafana data volume grows: log lines/bytes per app, spans per service, metric series per app, store sizes and 24h growth. Default range is 6h and auto-refresh is off on purpose: the byte panels scan every log line in range (24h ≈ 12 s and ~2,000 open files on VictoriaLogs), so widen the range when you need it rather than leaving it polling.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "timezone": "utc",
  "refresh": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus_on_fly"
        },
        "query": "label_values(fly_instance_up, app)",
        "definition": "label_values(fly_instance_up, app)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
