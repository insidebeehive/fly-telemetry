      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "application_logs"
          },
          "refId": "A",
          "expr": "_stream:{fly.app.name=~\"${app:regex}\"} | stats by (fly.app.name) count() lines | sort by (lines) desc | limit 30",
          "queryType": "stats",
          "legendFormat": "{{fly.app.name}}",
          "maxLines": 1000,
          "step": ""
