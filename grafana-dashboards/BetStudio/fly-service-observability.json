{
  "uid": "beehive-service-obs",
  "title": "Service Observability",
  "description": "Per-service metrics, logs and traces in one place. Layout after grafana/intro-to-mltp and the RED-method guidance; service dropdown after spanmetrics demo #18264.",
  "tags": [
    "beehive",
    "observability"
  ],
  "style": "dark",
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Fly app",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus_on_fly"
        },
        "query": "label_values(fly_instance_up, app)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "trace_service",
        "label": "Trace service",
        "type": "query",
        "datasource": {
          "type": "jaeger",
          "uid": "victoria_traces_jaeger"
        },
        "query": {
          "queryType": "services",
          "refId": "JaegerVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "links": [
    {
      "title": "Explore logs for $app",
      "type": "link",
      "icon": "doc",
      "targetBlank": true,
      "url": "/explore?schemaVersion=1&panes=%7B%22a%22:%7B%22datasource%22:%22application_logs%22,%22queries%22:%5B%7B%22refId%22:%22A%22,%22expr%22:%22_stream:%7Bfly.app.name=%5C%22$app%5C%22%7D%22%7D%5D%7D%7D&orgId=1"
    },
    {
      "title": "Explore traces",
      "type": "link",
      "icon": "info",
      "targetBlank": true,
      "url": "/explore?left=%7B%22datasource%22:%22victoria_traces_jaeger%22%7D&orgId=1"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Requests / s",
      "description": "HTTP responses served via Fly proxy for $app",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_on_fly"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "sum(rate(fly_app_http_responses_count{app=\"$app\"}[$__rate_interval]))",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_on_fly"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "100 * sum(rate(fly_app_http_responses_count{app=\"$app\",status=~\"5..\"}[$__rate_interval])) / sum(rate(fly_app_http_responses_count{app=\"$app\"}[$__rate_interval]))",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4CAF72",
                "value": null
              },
              {
                "color": "#E0A63C",
                "value": 1
              },
              {
                "color": "#D64550",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_on_fly"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "histogram_quantile(0.95, sum(rate(fly_app_http_response_time_seconds_bucket{app=\"$app\"}[$__rate_interval])) by (le))",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4CAF72",
                "value": null
              },
              {
                "color": "#E0A63C",
                "value": 0.5
              },
              {
                "color": "#D64550",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Instances up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_on_fly"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "sum(fly_instance_up{app=\"$app\"})",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#D64550",
                "value": null
              },
              {
                "color": "#4CAF72",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Request rate by status",
      "description": "Status colors are semantic: 2xx green, 3xx blue, 4xx amber, 5xx red",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_on_fly"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "sum(rate(fly_app_http_responses_count{app=\"$app\"}[$__rate_interval])) by (status)",
          "refId": "A",
          "range": true,
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^2../"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4CAF72"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^3../"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4E79A7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^4../"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E0A63C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^5../"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D64550"
                }
              }
            ]
          }
        ]
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_on_fly"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "histogram_quantile(0.50, sum(rate(fly_app_http_response_time_seconds_bucket{app=\"$app\"}[$__rate_interval])) by (le))",
          "refId": "A",
          "range": true,
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "histogram_quantile(0.95, sum(rate(fly_app_http_response_time_seconds_bucket{app=\"$app\"}[$__rate_interval])) by (le))",
          "refId": "B",
          "range": true,
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "histogram_quantile(0.99, sum(rate(fly_app_http_response_time_seconds_bucket{app=\"$app\"}[$__rate_interval])) by (le))",
          "refId": "C",
          "range": true,
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^p50$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4E79A7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^p95$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8C6BB1"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^p99$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E07B39"
                }
              }
            ]
          }
        ]
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Memory used % (per instance)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_on_fly"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "100 * (1 - fly_instance_memory_mem_available{app=\"$app\"} / fly_instance_memory_mem_total{app=\"$app\"})",
          "refId": "A",
          "range": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "logs",
      "title": "HTTP requests  \u00b7  logger=http",
      "description": "Structured request/response records (populated once the http.log middleware is deployed). Expand a line for method/status/duration/bodies; trace_id links to the trace.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "application_logs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "application_logs"
          },
          "expr": "_stream:{fly.app.name=\"$app\",logger=\"http\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 8
    },
    {
      "type": "logs",
      "title": "Application logs  \u00b7  everything except http",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "application_logs"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "application_logs"
          },
          "expr": "_stream:{fly.app.name=\"$app\",logger!=\"http\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 9
    },
    {
      "type": "logs",
      "title": "Errors",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "application_logs"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "application_logs"
          },
          "expr": "_stream:{fly.app.name=\"$app\"} level:error",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 10
    },
    {
      "type": "traces",
      "title": "Recent traces  \u00b7  service = $trace_service",
      "description": "Trace service names come from OTEL_SERVICE_NAME (equals the Fly app name for preload-instrumented services; core uses APP_NAME). Click a trace for the span waterfall; spans link back to logs.",
      "datasource": {
        "type": "jaeger",
        "uid": "victoria_traces_jaeger"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "jaeger",
            "uid": "victoria_traces_jaeger"
          },
          "queryType": "search",
          "service": "$trace_service",
          "limit": 20,
          "refId": "A"
        }
      ],
      "options": {},
      "id": 11
    }
  ]
}